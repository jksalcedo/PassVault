<resources>

    <style name="Base.Theme.PassVault" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors - Subtle arctic accent -->
        <item name="colorPrimary">@color/polar_night</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/arctic_sky</item>
        <item name="colorOnPrimaryContainer">@color/polar_night</item>

        <item name="colorSecondary">@color/nordic_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/frozen_mist</item>
        <item name="colorOnSecondaryContainer">@color/deep_fjord</item>

        <item name="colorTertiary">@color/northern_lights</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorTertiaryContainer">@color/aurora_teal</item>
        <item name="colorOnTertiaryContainer">@color/black</item>

        <!-- Surface colors - Clean white/light surfaces -->
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/grey_50</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/grey_100</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/grey_600</item>

        <!-- Background color - Pure white -->
        <item name="android:colorBackground">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Fonts -->
        <item name="fontFamily">@font/worksans_variable</item>
        <item name="android:fontFamily">@font/worksans_variable</item>

        <!--        <item name="bottomAppBarStyle">@style/Widget.PassVault.BottomAppBar</item>-->

        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <style name="Theme.PassVault" parent="Base.Theme.PassVault" />

    <style name="Theme.PassVault.OLED" parent="Base.Theme.PassVault">
        <!-- Primary colors - Arctic Blue accent (copied from night theme) -->
        <item name="colorPrimary">@color/ice_flow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/deep_fjord</item>
        <item name="colorOnPrimaryContainer">@color/arctic_ice</item>

        <!-- Secondary colors - Nordic Blue -->
        <item name="colorSecondary">@color/nordic_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/polar_night</item>
        <item name="colorOnSecondaryContainer">@color/frozen_mist</item>

        <item name="colorTertiary">@color/northern_lights</item>
        <item name="colorOnTertiary">@color/black</item>

        <!-- OLED Surface colors - Pure black -->
        <item name="colorSurface">@color/black</item>
        <item name="colorSurfaceVariant">#121212</item>
        <item name="colorSurfaceContainer">@color/black</item>
        <item name="colorSurfaceContainerLow">@color/black</item>
        <item name="colorSurfaceContainerLowest">@color/black</item>
        <item name="colorSurfaceContainerHigh">#121212</item>
        <item name="colorSurfaceContainerHighest">#1c1c1c</item>
        <item name="colorOnSurface">@color/arctic_ice</item>
        <item name="colorOnSurfaceVariant">@color/arctic_sky</item>

        <!-- Background color - Pure black -->
        <item name="android:colorBackground">@color/black</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

